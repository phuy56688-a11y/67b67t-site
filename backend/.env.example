# ==============================================================================
# 67B67T — CẤU HÌNH HỆ THỐNG THANH TOÁN ZALOPAY & CẤP RANK MINECRAFT
# ==============================================================================

# Cổng lắng nghe của Backend Server
PORT=5000
NODE_ENV=development

# URL của Website Frontend (để cấu hình CORS an toàn)
FRONTEND_URL=https://67b67t.site

# ==============================================================================
# CẤU HÌNH ZALOPAY MERCHANT API
# ==============================================================================
# Chế độ: 'sandbox' (Thử nghiệm) hoặc 'production' (Chính thức)
ZALOPAY_ENV=sandbox

# Khi bạn đăng ký tài khoản ZaloPay Merchant thành công, ZaloPay sẽ cấp cho bạn:
# 1. App ID (số nguyên, ví dụ: 2553 hoặc 554)
# 2. Key 1 (dùng để tạo chữ ký MAC khi tạo đơn hàng thanh toán)
# 3. Key 2 (dùng để xác thực chữ ký MAC của Callback Webhook khi ZaloPay bắn thông báo)
#
# LƯU Ý QUAN TRỌNG:
# - Để trống hoặc giữ nguyên giá trị mặc định bên dưới nếu bạn CHƯA có tài khoản Merchant.
# - Website sẽ tự động nhận diện và hiển thị trạng thái "Chờ cấu hình ZaloPay" an toàn.
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=

# URL Callback mà ZaloPay sẽ gọi khi khách quét mã thanh toán thành công
# (Phải là địa chỉ public truy cập được qua Internet, ví dụ dùng Domain có SSL hoặc Ngrok khi test)
# Ví dụ: https://api.67b67t.site/api/payment/callback
ZALOPAY_CALLBACK_URL=http://localhost:5000/api/payment/callback

# Endpoint API chính thức của ZaloPay (Thường không cần đổi)
ZALOPAY_ENDPOINT_CREATE_SANDBOX=https://sb-openapi.zalopay.vn/v2/create
ZALOPAY_ENDPOINT_CREATE_PROD=https://openapi.zalopay.vn/v2/create
ZALOPAY_ENDPOINT_QUERY_SANDBOX=https://sb-openapi.zalopay.vn/v2/query
ZALOPAY_ENDPOINT_QUERY_PROD=https://openapi.zalopay.vn/v2/query

# ==============================================================================
# CẤU HÌNH GÓI RANK PLUS
# ==============================================================================
# Giá bán Rank Plus (đơn vị: VNĐ)
RANK_PLUS_PRICE=50000
RANK_PLUS_NAME=Rank Plus (4 Home + 5 Ender Chest)

# ==============================================================================
# CẤU HÌNH KẾT NỐI MINECRAFT RCON (PAPER 1.21.11)
# ==============================================================================
# Bật RCON trong file server.properties của Minecraft Server:
#   enable-rcon=true
#   rcon.port=25575
#   rcon.password=mat_khau_rcon_bao_mat_cua_ban
RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASSWORD=mat_khau_rcon_bao_mat_cua_ban

# Tên lệnh Skript cấp rank được định nghĩa trong file rank.sk
# Ví dụ: giverank %PLAYER% plus %ORDER_ID%
RCON_RANK_COMMAND=giverank {username} plus {orderId}

# Thời gian chạy worker kiểm tra và thử cấp lại cho các đơn hàng chưa giao được (ms)
# Mặc định: 60000ms = 60 giây
RETRY_WORKER_INTERVAL_MS=60000
